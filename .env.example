# 复制为 .env 后填写(.env 不会提交到 git)。不填写则以演示模式运行。
PORT=8080
# 手机扫码访问的地址(默认自动取本机局域网 IP),例如 http://192.168.1.20:8080
PUBLIC_URL=
# 固定「数据截至日」(演示用,可留空取当天),例如 2026-11-09
DEMO_TODAY=

# 飞书群自定义机器人(群设置 → 机器人 → 添加自定义机器人)
FEISHU_WEBHOOK=
# 机器人「签名校验」密钥(可选)
FEISHU_SECRET=
# 飞书开放平台自建应用(导入 / 导出飞书电子表格、多维表格用;所需权限见 README「飞书配置」)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 导出新建的表格归应用所有,填写下面任一项后会把你加为可编辑协作者并尝试转移所有权
# 你在该应用下的 open_id(ou_ 开头;开放平台「API 调试台」可查)
FEISHU_OWNER_OPEN_ID=
# 或你的飞书登录邮箱
FEISHU_OWNER_EMAIL=
# 多维表格日期字段换算用的时区
FEISHU_TZ=Asia/Shanghai
# 飞书域名(海外 Lark 用 https://open.larksuite.com)
FEISHU_DOMAIN=https://open.feishu.cn

# 老板早报推送时间(24 小时制)
BRIEF_TIME=08:00

# 大模型(可选,用于撰写早报 / 智能识别导入表格);不填使用规则 + 模板
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
